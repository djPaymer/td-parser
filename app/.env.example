# HTML fetch (TLS сайтов производителей по умолчанию не проверяется)
APP_CONFIG__FETCH__TIMEOUT=45
# проверка доступности главной страницы до того, как сайт займёт слот concurrency
# APP_CONFIG__FETCH__PREFLIGHT_TIMEOUT=15
APP_CONFIG__FETCH__DELAY_SECONDS=0.35
APP_CONFIG__FETCH__VERIFY_SSL=false
# optional: override browser User-Agent
# APP_CONFIG__FETCH__USER_AGENT=
# страницы каталогов с мега-меню доходят до 1 МБ; лимит на размер ответа
# APP_CONFIG__FETCH__MAX_BYTES=3000000

# Yandex OpenAI-compatible: responses.create (пустой ключ = эвристический выбор формы URL)
APP_CONFIG__AGENT__API_KEY=
APP_CONFIG__AGENT__BASE_URL=https://ai.api.cloud.yandex.net/v1
APP_CONFIG__AGENT__MODEL=deepseek-v4-flash/latest
APP_CONFIG__AGENT__FOLDER_ID=
# сколько страниц сайта скачать при выводе regex товара
# APP_CONFIG__AGENT__MAX_PAGES=16
# минимум найденных ссылок на товары, чтобы regex считался рабочим
# APP_CONFIG__AGENT__MIN_HITS=3
# бюджет ответа модели (reasoning-модели тратят скрытые токены до ответа)
# APP_CONFIG__AGENT__MAX_OUTPUT_TOKENS=4000

# Headless Chromium (Playwright) — запасной вариант для JS-сайтов и 403.
# Нужен `poetry run playwright install chromium`; без него просто отключается.
APP_CONFIG__BROWSER__ENABLED=true
# таймаут загрузки страницы в браузере
# APP_CONFIG__BROWSER__TIMEOUT=30
# пауза после загрузки, чтобы SPA дорисовало DOM
# APP_CONFIG__BROWSER__SETTLE_SECONDS=0.8
# сколько карточек проверить по http, прежде чем решить, что они пустые, и перечитать в браузере
# APP_CONFIG__BROWSER__PROBE_PRODUCTS=5

# Лимиты сбора на один сайт (0 = без ограничения)
# страниц листингов/категорий/пагинации при сборе URL товаров — страховка от бесконечных сайтов
APP_CONFIG__PARSE__MAX_LISTING_PAGES=2000
# страниц пагинации на один листинг
APP_CONFIG__PARSE__MAX_PAGES_PER_LISTING=200
# остановить обход сайта после N страниц подряд без нового товара (маленький каталог на большом сайте)
APP_CONFIG__PARSE__MAX_STALE_PAGES=300
# карточек товаров; 0 = скачивать все найденные
APP_CONFIG__PARSE__MAX_PRODUCTS=0
# сайтов параллельно
APP_CONFIG__PARSE__CONCURRENCY=3
