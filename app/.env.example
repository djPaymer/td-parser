APP_CONFIG__RUN__HOST=0.0.0.0
APP_CONFIG__RUN__PORT=8000

# HTML fetch (TLS сайтов производителей по умолчанию не проверяется)
APP_CONFIG__FETCH__TIMEOUT=45
APP_CONFIG__FETCH__DELAY_SECONDS=0.35
APP_CONFIG__FETCH__VERIFY_SSL=false
# optional: override browser User-Agent
# APP_CONFIG__FETCH__USER_AGENT=
# страницы каталогов с мега-меню доходят до 1 МБ; лимит на размер ответа
# APP_CONFIG__FETCH__MAX_BYTES=3000000

# Yandex OpenAI-compatible: responses.create
APP_CONFIG__AGENT__API_KEY=
APP_CONFIG__AGENT__BASE_URL=https://ai.api.cloud.yandex.net/v1
APP_CONFIG__AGENT__MODEL=deepseek-v4-flash/latest
APP_CONFIG__AGENT__FOLDER_ID=
# сколько страниц сайта скачать при построении инструкции
# APP_CONFIG__AGENT__MAX_PAGES=16
# минимум найденных ссылок на товары, чтобы инструкция считалась рабочей
# APP_CONFIG__AGENT__MIN_HITS=3
# бюджет ответа модели (reasoning-модели тратят скрытые токены до ответа)
# APP_CONFIG__AGENT__MAX_OUTPUT_TOKENS=4000

# PostgreSQL (пустая строка отключает хранение инструкций)
APP_CONFIG__DB__URL=postgresql://service:service@localhost:5432/parser
# через сколько дней автоматически собранная инструкция пересобирается (0 = никогда)
APP_CONFIG__STORE__TTL_DAYS=30
